{
  "name": "@rekkr/orm",
  "version": "3.1.1",
  "description": "An Eloquent-inspired ORM for Bun's native SQL client supporting SQLite, MySQL, and PostgreSQL.",
  "license": "MIT",
  "packageManager": "bun@1.4.1",
  "keywords": [
    "bun",
    "orm",
    "eloquent",
    "sqlite",
    "mysql",
    "postgresql",
    "database"
  ],
  "repository": {
    "type": "git",
    "url": "git+https://github.com/rekkrjs/orm.git"
  },
  "bugs": {
    "url": "https://github.com/rekkrjs/orm/issues"
  },
  "homepage": "https://github.com/rekkrjs/orm#readme",
  "main": "dist/src/index.js",
  "module": "dist/src/index.js",
  "types": "./src/index.ts",
  "exports": {
    ".": {
      "bun": "./src/index.ts",
      "types": "./src/index.ts",
      "import": "./dist/src/index.js"
    },
    "./validation": {
      "bun": "./src/validation/index.ts",
      "types": "./src/validation/index.ts",
      "import": "./dist/src/validation/index.js"
    },
    "./cache": {
      "bun": "./src/cache/index.ts",
      "types": "./src/cache/index.ts",
      "import": "./dist/src/cache/index.js"
    },
    "./events": {
      "bun": "./src/events/index.ts",
      "types": "./src/events/index.ts",
      "import": "./dist/src/events/index.js"
    },
    "./queue": {
      "bun": "./src/queue/index.ts",
      "types": "./src/queue/index.ts",
      "import": "./dist/src/queue/index.js"
    },
    "./commands": {
      "bun": "./src/commands/index.ts",
      "types": "./src/commands/index.ts",
      "import": "./dist/src/commands/index.js"
    },
    "./search": {
      "bun": "./src/search/index.ts",
      "types": "./src/search/index.ts",
      "import": "./dist/src/search/index.js"
    },
    "./sveltekit": {
      "bun": "./src/sveltekit/index.ts",
      "types": "./src/sveltekit/index.ts",
      "import": "./dist/src/sveltekit/index.js"
    },
    "./policies": {
      "bun": "./src/policies/index.ts",
      "types": "./src/policies/index.ts",
      "import": "./dist/src/policies/index.js"
    }
  },
  "typesVersions": {
    "*": {
      "validation": [
        "./src/validation/index.ts"
      ],
      "cache": [
        "./src/cache/index.ts"
      ],
      "events": [
        "./src/events/index.ts"
      ],
      "queue": [
        "./src/queue/index.ts"
      ],
      "commands": [
        "./src/commands/index.ts"
      ],
      "search": [
        "./src/search/index.ts"
      ],
      "sveltekit": [
        "./src/sveltekit/index.ts"
      ],
      "policies": [
        "./src/policies/index.ts"
      ]
    }
  },
  "type": "module",
  "bin": {
    "orm": "./bin/orm.ts"
  },
  "engines": {
    "bun": ">=1.4.1"
  },
  "publishConfig": {
    "access": "public"
  },
  "scripts": {
    "build": "rm -rf ./dist && tsc",
    "prepack": "bun run build",
    "test": "tsc -p tsconfig.test.json && bun test --parallel --path-ignore-patterns='**/benchmark*'",
    "bench": "bun test tests/benchmark*.test.ts",
    "bench:record": "bun run scripts/benchmark-history.ts",
    "bench:runtime": "bun run scripts/benchmark-runtime.ts",
    "bench:http": "bun run scripts/benchmark-http.ts",
    "migrate": "bun run bin/orm.ts migrate",
    "make:migration": "bun run bin/orm.ts make:migration",
    "migrate:rollback": "bun run bin/orm.ts migrate:rollback",
    "migrate:status": "bun run bin/orm.ts migrate:status"
  },
  "dependencies": {},
  "peerDependencies": {
    "@sveltejs/kit": "^2.0.0"
  },
  "peerDependenciesMeta": {
    "@sveltejs/kit": {
      "optional": true
    }
  },
  "files": [
    "src",
    "bin",
    "dist",
    "README.md",
    "LICENSE"
  ],
  "devDependencies": {
    "@types/bun": "latest",
    "@sveltejs/kit": "^2.70.3",
    "typescript": "^7.0.2"
  },
  "overrides": {
    "cookie": "^0.7.2"
  }
}
